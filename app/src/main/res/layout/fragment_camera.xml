<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/btnCloseCamera"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_stonicx_icon_square"
        android:src="@drawable/ic_overlay_close"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="Close camera" />

    <TextView
        android:id="@+id/tvCameraCaptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="104dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_camera_caption"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:maxLines="4"
        android:ellipsize="end"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnFlipCamera"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_stonicx_icon_square"
        android:src="@android:drawable/ic_menu_rotate"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="Switch camera" />

</FrameLayout>
